# DigitalOcean API token -- used by Terraform (provider reads DIGITALOCEAN_TOKEN)
# and by the Nix dev shell. Get one at:
#   https://cloud.digitalocean.com/account/api/tokens
#
# Copy this file to .env (git-ignored) and replace the placeholder:
#   cp .env.example .env
export DIGITALOCEAN_TOKEN="METTRE_ICI_VOTRE_JETON_API"

# DigitalOcean Spaces access keys for the remote Terraform state backend only.
# Do not reuse the PostgreSQL backup key here. Create restricted, independent
# keys and keep the values only in the local .env/CI secret store.
export AWS_ACCESS_KEY_ID="METTRE_ICI_LA_CLE_SPACES"
export AWS_SECRET_ACCESS_KEY="METTRE_ICI_LE_SECRET_SPACES"

# Pin the reviewed DOKS control-plane version; never provision from "latest".
# Obtain supported values with: doctl kubernetes options versions
export TF_VAR_kubernetes_version="REVIEWED_DOKS_VERSION"
