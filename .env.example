# DigitalOcean API token -- used by Terraform (provider reads DIGITALOCEAN_TOKEN)
# and by the Nix dev shell. Get one at:
#   https://cloud.digitalocean.com/account/api/tokens
#
# Copy this file to .env (git-ignored) and replace the placeholder:
#   cp .env.example .env
export DIGITALOCEAN_TOKEN="METTRE_ICI_VOTRE_JETON_API"
